{
  "$schema": "dovastash-autotest-1",
  "name": "Ebongrove - Recall and Teleport SE (Undriel_Ebongrove.esp, mod home; unowned interior, racks, a load door)",
  "home": "Undriel_Ebongrove.esp|0x00026902",
  "coc": "0Ebongrove",
  "templates": ["54_Ebongrove.json"],
  "tests": [
    {
      "id": "1.1-ebongrove", "title": "Template offered on the first visit (the cell has no owner: accepted as unowned)",
      "steps": [
        {"do": "enter"},
        {"check": "home", "is": true, "layout": false},
        {"check": "log", "since": "plan", "regex": "Cell .*\\(Undriel_Ebongrove\\.esp\\|0x00026902\\): template available"},
        {"check": "notify", "since": "plan", "regex": "Dova Stash: Ebongrove \\(AutoTest\\) setup available"}
      ]
    },
    {
      "id": "3.6-ebongrove", "title": "Use template, Deposit spreads weapons, potions and soul gems",
      "steps": [
        {"do": "useTemplate"},
        {"check": "notify", "contains": "Dova Stash: Ebongrove (AutoTest) setup enabled"},
        {"check": "layout", "pointer": "/basedOn", "eq": "Templates/AutoTest/54_Ebongrove.json@1.0.0"},
        {"check": "layout", "pointer": "/master", "eq": "Undriel_Ebongrove.esp|0x0009BB37"},
        {"do": "additem", "item": "Skyrim.esm|0x00012EB7", "count": 2},
        {"do": "additem", "item": "Skyrim.esm|0x0003EADD", "count": 2},
        {"do": "additem", "item": "Skyrim.esm|0x0002E4E2", "count": 1},
        {"do": "snapshot", "name": "dep"},
        {"do": "op", "op": "Deposit"},
        {"do": "waitIdle"},
        {"check": "count", "in": "Undriel_Ebongrove.esp|0x0017ACF8", "item": "Skyrim.esm|0x00012EB7", "from": "dep", "ge": 2},
        {"check": "count", "in": "Undriel_Ebongrove.esp|0x000C44B5", "item": "Skyrim.esm|0x0003EADD", "from": "dep", "ge": 2},
        {"check": "count", "in": "Undriel_Ebongrove.esp|0x000C9604", "item": "Skyrim.esm|0x0002E4E2", "from": "dep", "ge": 1},
        {"check": "conserved", "snapshot": "dep"},
        {"check": "noErrors"}
      ]
    },
    {
      "id": "3.7-ebongrove", "title": "Weapon rack (Left Weapon Rack 0x0011F984, enabled by the test: it starts disabled) takes a weapon on Deposit",
      "steps": [
        {"do": "enable", "ref": "Undriel_Ebongrove.esp|0x0011F984"},
        {"do": "require", "enabled": "Undriel_Ebongrove.esp|0x0011F984", "why": "the rack is built with the home's decoration"},
        {"do": "displayUse", "ref": "Undriel_Ebongrove.esp|0x0011F984"},
        {"do": "additem", "item": "Skyrim.esm|0x000139B9", "count": 1},
        {"do": "op", "op": "Deposit"},
        {"do": "waitIdle"},
        {"check": "log", "regex": "Display: Daedric Sword .* on .*\\(rack\\)", "within": 10},
        {"check": "count", "item": "Skyrim.esm|0x000139B9", "eq": 0},
        {"check": "noErrors"}
      ]
    },
    {
      "id": "3.4-ebongrove", "title": "Sort all and Retrieve by category (weapons)",
      "steps": [
        {"do": "additem", "item": "Skyrim.esm|0x0001397E", "count": 2},
        {"do": "snapshot", "name": "sortall"},
        {"do": "op", "op": "Deposit"},
        {"do": "waitIdle"},
        {"check": "count", "in": "Undriel_Ebongrove.esp|0x0017ACF8", "item": "Skyrim.esm|0x0001397E", "ge": 2},
        {"do": "op", "op": "SortAll"},
        {"do": "waitIdle"},
        {"do": "op", "op": "Retrieve", "pattern": "weapons.*"},
        {"check": "count", "item": "Skyrim.esm|0x0001397E", "ge": 2},
        {"check": "conserved", "snapshot": "sortall"},
        {"do": "op", "op": "Deposit"},
        {"check": "noErrors"}
      ]
    },
    {
      "id": "3.5-ebongrove", "title": "Ignore a container and stop ignoring it",
      "steps": [
        {"do": "ignore", "ref": "Undriel_Ebongrove.esp|0x0017AC77"},
        {"check": "notify", "contains": "is now ignored"},
        {"check": "layout", "pointer": "/containers", "contains": {"ref": "Undriel_Ebongrove.esp|0x0017AC77", "ignored": true}},
        {"do": "ignore", "ref": "Undriel_Ebongrove.esp|0x0017AC77", "on": false},
        {"check": "notify", "contains": "is managed again"},
        {"check": "noErrors"}
      ]
    },
    {
      "id": "3.8a-ebongrove", "title": "Restock to a keep quota",
      "steps": [
        {"do": "keep", "keep": {"quotas": [{"category": "alchemy.potions", "quota": 2, "restock": true}]}},
        {"do": "op", "op": "Restock"},
        {"check": "notify", "regex": "Dova Stash: (restocked \\d+ items?|nothing to restock)"},
        {"do": "keep", "keep": null},
        {"check": "noErrors"}
      ]
    },
    {
      "id": "3.8b-ebongrove", "title": "Craft from storage at the cooking pot 0x00203A6E (esm_dump furniture, CraftingCookpot)",
      "steps": [
        {"do": "sit", "ref": "Undriel_Ebongrove.esp|0x00203A6E", "keyword": "CraftingCookpot"},
        {"check": "crafting", "active": true, "within": 5},
        {"do": "closeMenu", "menu": "Crafting Menu"},
        {"check": "crafting", "active": false, "within": 5},
        {"check": "noErrors"}
      ]
    },
    {
      "id": "3.9-ebongrove", "title": "Add the grounds outside (load door 0x002C94A4 to DragonMoundVolcanicTundra01), Deposit from there, remove it",
      "steps": [
        {"do": "enter"},
        {"do": "exitDoor", "ref": "Undriel_Ebongrove.esp|0x002C94A4"},
        {"check": "home", "is": false},
        {"do": "addArea", "label": "Grounds"},
        {"check": "notify", "contains": "Grounds is now part of Ebongrove"},
        {"check": "layout", "pointer": "/cells", "contains": {"label": "Grounds"}},
        {"do": "additem", "item": "Skyrim.esm|0x0005ACE4", "count": 1},
        {"do": "op", "op": "Deposit"},
        {"check": "log", "contains": "Deposit in Ebongrove"},
        {"do": "removeArea"},
        {"check": "notify", "contains": "is no longer part of Ebongrove"},
        {"check": "layout", "pointer": "/cells", "absent": true},
        {"check": "noErrors"}
      ]
    },
    {
      "id": "3.5-ebongrove-master", "title": "Make master and Reset (last)",
      "steps": [
        {"do": "enter"},
        {"do": "makeMaster", "ref": "Undriel_Ebongrove.esp|0x002ECC98"},
        {"check": "layout", "pointer": "/master", "eq": "Undriel_Ebongrove.esp|0x002ECC98"},
        {"do": "makeMaster", "ref": "Undriel_Ebongrove.esp|0x0009BB37"},
        {"check": "layout", "pointer": "/master", "eq": "Undriel_Ebongrove.esp|0x0009BB37"},
        {"do": "reset"},
        {"check": "notify", "contains": "reset (setup backed up)"},
        {"check": "layoutFile", "exists": false},
        {"check": "noErrors"}
      ]
    }
  ]
}
