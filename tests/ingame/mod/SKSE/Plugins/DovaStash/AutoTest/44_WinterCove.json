        {
          "do": "additem",
          "item": "Skyrim.esm|0x00012EB6",
          "count": 1
        },
        {
          "do": "snapshot",
          "name": "displays"
        },
        {
          "do": "op",
          "op": "Deposit"
        },
        {
          "do": "waitIdle"
        },
        {
          "check": "displayHolds",
          "refs": [
            "Winter Cove.esp|0x00032489",
            "Winter Cove.esp|0x0003248B",
            "Winter Cove.esp|0x0003248F",
            "Winter Cove.esp|0x00032491",
            "Winter Cove.esp|0x000324B8",
            "Winter Cove.esp|0x000324B9",
            "Winter Cove.esp|0x000324BA",
            "Winter Cove.esp|0x000324BB"
          ],
          "item": "Skyrim.esm|0x00013989",
          "within": 10
        },
        {
          "check": "displayHolds",
          "refs": [
            "Winter Cove.esp|0x000324A7",
            "Winter Cove.esp|0x000324A8",
            "Winter Cove.esp|0x00032A21",
            "Winter Cove.esp|0x00032A22"
          ],
          "item": "Skyrim.esm|0x00012EB6",
          "within": 10
        },
        {
