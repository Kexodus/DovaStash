{
  "$schema": "dovastash-autotest-1",
  "name": "Myrwatch (Creation Club)",
  "home": "ccEEJSSE002-Tower.esl|0x0000083B",
  "coc": "ccEEJSSE002MageTowerMain",
  "tests": [
    {
      "id": "1.1-myrwatch",
      "title": "Template offered on the first visit",
      "steps": [
        {
          "do": "enter"
        },
        {
          "check": "home",
          "is": true,
          "name": "Myrwatch",
          "layout": false
        },
        {
          "check": "log",
          "since": "plan",
          "regex": "template: Myrwatch v[0-9.]+ by Dova Stash"
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.6-myrwatch",
      "title": "Use template; Deposit sorts by category; the bookshelves (ignored as storage, listed as displays) get one copy of a book, the mannequin the armor",
      "steps": [
        {
          "do": "clearInventory"
        },
        {
          "do": "useTemplate"
        },
        {
          "check": "notify",
          "contains": "Dova Stash: Myrwatch is set up"
        },
        {
          "check": "layout",
          "pointer": "/basedOn",
          "contains": "Templates/CreationClub/Myrwatch.json@"
        },
        {
          "check": "layout",
          "pointer": "/master",
          "eq": "ccEEJSSE002-Tower.esl|0x00000B3A"
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x00012EB7",
          "count": 2
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x0001ACE6",
          "count": 2
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x00013911",
          "count": 1
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x0005ACE4",
          "count": 3
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x0000000F",
          "count": 300
        },
        {
          "do": "snapshot",
          "name": "myr"
        },
        {
          "do": "op",
          "op": "Deposit"
        },
        {
          "do": "waitIdle"
        },
        {
          "check": "count",
          "in": "ccEEJSSE002-Tower.esl|0x00000B15",
          "item": "Skyrim.esm|0x00012EB7",
          "from": "myr",
          "eq": 2
        },
        {
          "check": "count",
          "in": "ccEEJSSE002-Tower.esl|0x00000BC6",
          "item": "Skyrim.esm|0x0001ACE6",
          "from": "myr",
          "eq": 1
        },
        {
          "check": "log",
          "regex": "Display: Aevar Stone-Singer .* on .*\\(bookshelf\\)",
          "within": 10
        },
        {
          "check": "count",
          "in": "ccEEJSSE002-Tower.esl|0x00000B2D",
          "item": "Skyrim.esm|0x00013911",
          "from": "myr",
          "eq": 0
        },
        {
          "check": "log",
          "regex": "Display: Hide Armor .* on .*\\(mannequin\\)",
          "within": 10
        },
        {
          "check": "count",
          "in": "master",
          "item": "Skyrim.esm|0x0005ACE4",
          "from": "myr",
          "eq": 3
        },
        {
          "check": "gold",
          "snapshot": "myr"
        },
        {
          "check": "conserved",
          "snapshot": "myr"
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.4-myrwatch",
      "title": "Retrieve by category takes weapons back and nothing else",
      "steps": [
        {
          "do": "op",
          "op": "Retrieve",
          "pattern": "weapons.*"
        },
        {
          "check": "count",
          "item": "Skyrim.esm|0x00012EB7",
          "eq": 2
        },
        {
          "do": "op",
          "op": "Deposit"
        },
        {
          "check": "count",
          "in": "ccEEJSSE002-Tower.esl|0x00000B15",
          "item": "Skyrim.esm|0x00012EB7",
          "eq": 2
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.5-myrwatch",
      "title": "Ignore: the armory cupboard takes nothing; managed again afterwards",
      "steps": [
        {
          "do": "additem",
          "item": "Skyrim.esm|0x00013911",
          "count": 1
        },
        {
          "do": "snapshot",
          "name": "ign"
        },
        {
          "do": "ignore",
          "ref": "ccEEJSSE002-Tower.esl|0x00000B2D"
        },
        {
          "check": "notify",
          "contains": "is now ignored"
        },
        {
          "check": "layout",
          "pointer": "/containers",
          "contains": {
            "ref": "ccEEJSSE002-Tower.esl|0x00000B2D",
            "ignored": true
          }
        },
        {
          "do": "op",
          "op": "Deposit"
        },
        {
          "check": "log",
          "absent": true,
          "regex": "Deposit: Hide Armor \\[Skyrim\\.esm\\|0x00013911\\] x1 -> Chest \\(ref\\) \\[cceejsse002-tower\\.esl\\|0x00000b2d\\]"
        },
        {
          "check": "count",
          "in": "master",
          "item": "Skyrim.esm|0x00013911",
          "from": "ign",
          "eq": 1
        },
        {
          "do": "ignore",
          "ref": "ccEEJSSE002-Tower.esl|0x00000B2D",
          "on": false
        },
        {
          "check": "notify",
          "contains": "is managed again"
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.7-myrwatch",
      "title": "Displays: a rack in use takes a weapon on Deposit",
      "steps": [
        {
          "do": "enable",
          "ref": "ccEEJSSE002-Tower.esl|0x00000C57"
        },
        {
          "do": "require",
          "enabled": "ccEEJSSE002-Tower.esl|0x00000C57",
          "why": "Myrwatch's weapon rack comes with the decoration"
        },
        {
          "do": "displayUse",
          "ref": "ccEEJSSE002-Tower.esl|0x00000C57"
        },
        {
          "check": "notify",
          "contains": "is used now"
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x000139B9",
          "count": 1
        },
        {
          "do": "op",
          "op": "Deposit"
        },
        {
          "do": "waitIdle"
        },
        {
          "check": "log",
          "regex": "Display: Daedric Sword .* on .*\\(rack\\)",
          "within": 10
        },
        {
          "check": "count",
          "item": "Skyrim.esm|0x000139B9",
          "eq": 0
        },
        {
          "check": "log",
          "absent": true,
          "regex": "did not take|had no 3D"
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.5-myrwatch-reset",
      "title": "Reset backs the setup up",
      "steps": [
        {
          "do": "reset"
        },
        {
          "check": "notify",
          "contains": "reset (setup backed up)"
        },
        {
          "check": "layoutFile",
          "exists": false
        },
        {
          "check": "files",
          "dir": "Layouts",
          "regex": "cceejsse002-tower\\.esl_0000083B\\.json\\.\\d{8}-\\d{6}(-\\d+)?\\.bak",
          "ge": 1
        },
        {
          "check": "home",
          "layout": false
        }
      ]
    },
    {
      "id": "3.6a-myrwatch",
      "title": "Backup restored",
      "steps": [
        {
          "do": "restore"
        },
        {
          "check": "notify",
          "contains": "Dova Stash: Myrwatch restored"
        },
        {
          "check": "layout",
          "pointer": "/master",
          "eq": "ccEEJSSE002-Tower.esl|0x00000B3A"
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "1.1-gallery",
      "title": "Myrwatch Gallery (cell 0x92C) is part of Myrwatch: the merged template lists it, so it offers no template of its own",
      "steps": [
        {
          "do": "enter",
          "coc": "ccEEJSSE002MageTowerSecond"
        },
        {
          "check": "home",
          "is": true,
          "name": "Myrwatch",
          "layout": true
        },
        {
          "check": "log",
          "since": "plan",
          "regex": "Cell .* \\(ccEEJSSE002-Tower\\.esl\\|0x0000092C\\): part of Myrwatch",
          "within": 5
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.6-gallery",
      "title": "Gallery: Deposit puts potions in the gallery's own alchemy cupboard",
      "steps": [
        {
          "do": "additem",
          "item": "Skyrim.esm|0x0003EADD",
          "count": 4
        },
        {
          "do": "snapshot",
          "name": "gal"
        },
        {
          "do": "op",
          "op": "Deposit"
        },
        {
          "check": "count",
          "in": "ccEEJSSE002-Tower.esl|0x00000F8C",
          "item": "Skyrim.esm|0x0003EADD",
          "from": "gal",
          "eq": 4
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.7-gallery",
      "title": "Gallery: a rack in use takes a sword on Deposit",
      "steps": [
        {
          "do": "displayUse",
          "ref": "ccEEJSSE002-Tower.esl|0x0000092D"
        },
        {
          "check": "notify",
          "contains": "is used now"
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x00012EB7",
          "count": 1
        },
        {
          "do": "op",
          "op": "Deposit"
        },
        {
          "do": "waitIdle"
        },
        {
          "check": "log",
          "regex": "Display: Iron Sword .* on .*\\(rack\\)",
          "within": 10
        },
        {
          "check": "log",
          "absent": true,
          "regex": "did not take|had no 3D"
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.6.5-myrwatch",
      "title": "Save as template keeps the master; the export is offered at once",
      "steps": [
        {
          "do": "enter",
          "coc": "ccEEJSSE002MageTowerMain"
        },
        {
          "do": "export",
          "name": "AutoTest Myrwatch"
        },
        {
          "check": "templateFile",
          "name": "AutoTest Myrwatch.json",
          "pointer": "/cell",
          "eq": "ccEEJSSE002-Tower.esl|0x0000083B"
        },
        {
          "check": "templateFile",
          "name": "AutoTest Myrwatch.json",
          "pointer": "/master",
          "eq": "ccEEJSSE002-Tower.esl|0x00000B3A"
        },
        {
          "check": "templateFile",
          "name": "AutoTest Myrwatch.json",
          "pointer": "/learned",
          "absent": true
        },
        {
          "check": "bestTemplate",
          "source": "Templates/User/AutoTest Myrwatch.json"
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.9-myrwatch-whole",
      "title": "The whole-home template (with gallery) applied from the tower: the gallery joins the home; Deposit keeps every item",
      "steps": [
        {
          "do": "enter",
          "coc": "ccEEJSSE002MageTowerSecond"
        },
        {
          "do": "reset"
        },
        {
          "do": "enter",
          "coc": "ccEEJSSE002MageTowerMain"
        },
        {
          "do": "reset"
        },
        {
          "check": "home",
          "is": true,
          "layout": false
        },
        {
          "do": "useTemplate",
          "source": "Templates/CreationClub/Myrwatch.json",
          "why": "3.6.5-myrwatch saved \"AutoTest Myrwatch\" for this home, which is offered first now"
        },
        {
          "check": "notify",
          "regex": "Dova Stash: Myrwatch is set up"
        },
        {
          "check": "layout",
          "pointer": "/basedOn",
          "contains": "Templates/CreationClub/Myrwatch.json@"
        },
        {
          "check": "layout",
          "pointer": "/cells",
          "contains": {
            "cell": "ccEEJSSE002-Tower.esl|0x0000092C",
            "label": "Gallery"
          }
        },
        {
          "check": "layout",
          "pointer": "/master",
          "eq": "ccEEJSSE002-Tower.esl|0x00000B3A"
        },
        {
          "do": "clearInventory"
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x0003EADD",
          "count": 2
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x0005ACE4",
          "count": 4
        },
        {
          "do": "snapshot",
          "name": "whole"
        },
        {
          "do": "op",
          "op": "Deposit"
        },
        {
          "do": "waitIdle"
        },
        {
          "check": "conserved",
          "snapshot": "whole"
        },
        {
          "do": "reset"
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.7-myrwatch-visual",
      "title": "Display placement looks right in the gallery",
      "manual": "visual: the gallery's 142 displays (racks, 12 mannequins, 66 item displays): no floating or falling items"
    }
  ]
}
