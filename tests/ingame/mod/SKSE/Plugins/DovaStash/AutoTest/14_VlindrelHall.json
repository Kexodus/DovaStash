  "tests": [
    {
      "id": "1.1",
      "title": "Template offered on the first visit; the decorations are bought",
      "steps": [
        {
          "do": "enter"
        },
        {
          "check": "home",
          "is": true,
          "name": "Vlindrel Hall",
          "layout": false
        },
        {
          "check": "log",
          "since": "plan",
          "contains": "Cell Vlindrel Hall (Skyrim.esm|0x00016DFA): template available"
        },
        {
          "check": "log",
          "since": "plan",
          "regex": "template: Vlindrel Hall v[0-9.]+ by Dova Stash"
        },
        {
          "check": "notify",
          "since": "plan",
          "contains": "Dova Stash: Vlindrel Hall setup available (press K)"
        },
        {
          "do": "buyHome"
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
