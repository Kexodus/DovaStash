    {
      "id": "3.7-useall",
      "title": "Displays page > Use all racks... (Controller::UseDisplays): a setup without displays, one rack used then stopped (ignored); Use all racks lists the others as used, the ignored one stays off, the HUD says how many; nothing moves",
      "steps": [
        {"do": "buyHome"},
        {"do": "reset"},
        {"do": "makeMaster", "ref": "Skyrim.esm|0x00077CAB"},
        {"check": "layout", "pointer": "/displays", "absent": true, "why": "a setup made with Make master lists no displays"},
        {"do": "enable", "ref": "Skyrim.esm|0x000E2DA6"},
        {"do": "enable", "ref": "Skyrim.esm|0x000E2DAF"},
        {"do": "require", "enabled": "Skyrim.esm|0x000E2DAF", "why": "the mid weapon racks start disabled"},
        {"do": "displayUse", "ref": "Skyrim.esm|0x000E2DA6"},
        {"do": "displayUse", "ref": "Skyrim.esm|0x000E2DA6", "on": false},
        {"check": "layout", "pointer": "/displays", "contains": {"ref": "Skyrim.esm|0x000E2DA6", "ignored": true}},
        {"do": "snapshot", "name": "useall"},
        {"do": "displayUseAll", "kind": "rack"},
        {"check": "notify", "regex": "Dova Stash: \\d+ displays? used now"},
        {"check": "layout", "pointer": "/displays", "contains": {"ref": "Skyrim.esm|0x000E2DAF"}},
        {"check": "layout", "pointer": "/displays", "lacks": {"ref": "Skyrim.esm|0x000E2DAF", "ignored": true}},
        {"check": "layout", "pointer": "/displays", "contains": {"ref": "Skyrim.esm|0x000E2DA6", "ignored": true}},
        {"check": "conserved", "snapshot": "useall"},
        {"do": "reset"},
        {"check": "noErrors"}
      ]
    },
