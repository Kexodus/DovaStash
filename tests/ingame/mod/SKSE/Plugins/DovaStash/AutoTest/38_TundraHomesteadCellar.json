{
  "$schema": "dovastash-autotest-1",
  "name": "Tundra Homestead with its cellar (multi-cell)",
  "home": "ccEEJSSE001-Hstead.esm|0x0000087F",
  "coc": "0EEJSSE001House",
  "tests": [
    {
      "id": "3.9-tundra-a",
      "title": "Use the whole-home template (with cellar): its cells join the home",
      "steps": [
        {
          "do": "enter"
        },
        {
          "do": "reset"
        },
        {
          "check": "home",
          "is": true,
          "name": "Tundra Homestead",
          "layout": false
        },
        {
          "check": "bestTemplate",
          "source": "Templates/CreationClub/TundraHomestead.json"
        },
        {
          "do": "useTemplate"
        },
        {
          "check": "notify",
          "regex": "Dova Stash: Tundra Homestead setup enabled$",
          "why": "the cellar's containers wait for their area (not in memory from the hall): no count of unavailable ones"
        },
        {
          "check": "log",
          "absent": true,
          "regex": "Template container .* unavailable: nothing targeted"
        },
        {
          "check": "layout",
          "pointer": "/basedOn",
          "contains": "Templates/CreationClub/TundraHomestead.json@"
        },
        {
          "check": "layout",
          "pointer": "/cells",
          "contains": {
            "cell": "ccEEJSSE001-Hstead.esm|0x00000B06"
          }
        },
        {
          "check": "layout",
          "pointer": "/master",
          "eq": "ccEEJSSE001-Hstead.esm|0x00084A88"
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.9-tundra-b",
      "title": "Deposit in the cellar: its own weapons and armor go to its own containers and displays; the potion has no cellar container and goes to the cellar's chest (the area's own master: the hall's is not loaded)",
      "steps": [
        {
          "do": "enter",
          "coc": "0EEJSSE001HouseBasement"
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x00012EB7",
          "count": 2
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x00013911",
          "count": 1
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x0003EADD",
          "count": 3
        },
        {
          "do": "snapshot",
          "name": "cellar"
        },
        {
          "do": "op",
          "op": "Deposit"
        },
        {
          "do": "waitIdle"
        },
        {
          "check": "count",
          "in": "ccEEJSSE001-Hstead.esm|0x00000F87",
          "item": "Skyrim.esm|0x00012EB7",
          "from": "cellar",
          "ge": 1
        },
        {
          "check": "count",
          "item": "Skyrim.esm|0x00013911",
          "eq": 0
        },
        {
          "check": "count",
          "in": "ccEEJSSE001-Hstead.esm|0x00000F85",
          "item": "Skyrim.esm|0x0003EADD",
          "from": "cellar",
          "ge": 3
        },
        {
          "check": "count",
          "item": "Skyrim.esm|0x0003EADD",
          "eq": 0
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.9-tundra-b2",
      "title": "Deposit in an area without a master of its own: the HUD says it waits for the master, not 'nothing to deposit'",
      "manual": "the merged Tundra Homestead template gives the cellar its own master (cells[].master), so this home has no such area now; the hotkey title '(master not here)' is checked in 3.9-tundra-b3"
    },
    {
      "id": "3.9-tundra-b3",
      "title": "Hotkey in the cellar at nothing: the master menu is titled '(master not here)'",
      "steps": [
        {
          "do": "aim",
          "ref": null
        },
        {
          "do": "hotkey"
        },
        {
          "check": "menuEntries",
          "contains": [
            "Deposit"
          ],
          "body": "Dova Stash: Tundra Homestead (master not here)",
          "within": 5
        },
        {
          "do": "choose",
          "index": -1
        },
        {
          "do": "aim",
          "clear": true
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.9-tundra-c",
      "title": "Deposit in the cellar: books go to the cellar's bookcase and bookshelves (the hall's book cupboard is not loaded there)",
      "steps": [
        {
          "do": "additem",
          "item": "Skyrim.esm|0x0001ACE6",
          "count": 2
        },
        {
          "do": "snapshot",
          "name": "books"
        },
        {
          "do": "op",
          "op": "Deposit"
        },
        {
          "do": "waitIdle"
        },
        {
          "check": "count",
          "in": "ccEEJSSE001-Hstead.esm|0x00000D1B",
          "item": "Skyrim.esm|0x0001ACE6",
          "from": "books",
          "ge": 1,
          "within": 5
        },
        {
          "check": "conserved",
          "snapshot": "books"
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.9-tundra-d",
      "title": "Deposit in the hall: a sword goes to the hall's own container; the cellar's are not touched",
      "steps": [
        {
          "do": "enter",
          "coc": "0EEJSSE001House"
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x00012EB7",
          "count": 1
        },
        {
          "do": "snapshot",
          "name": "hall"
        },
        {
          "do": "op",
          "op": "Deposit"
        },
        {
          "do": "waitIdle"
        },
        {
          "check": "count",
          "in": "ccEEJSSE001-Hstead.esm|0x00000FBA",
          "item": "Skyrim.esm|0x00012EB7",
          "from": "hall",
          "eq": 1
        },
        {
          "check": "count",
          "in": "ccEEJSSE001-Hstead.esm|0x00000F87",
          "item": "Skyrim.esm|0x00012EB7",
          "from": "hall",
          "eq": 0
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.9-tundra-e",
      "title": "exitDoor from the cellar back to the hall",
      "steps": [
        {
          "do": "enter",
          "coc": "0EEJSSE001HouseBasement"
        },
        {
          "do": "exitDoor"
        },
        {
          "check": "home",
          "is": true,
          "name": "Tundra Homestead"
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.9-tundra-f",
      "title": "Reset in the cellar removes the whole home's layout; the cellar is its own home again, with no template of its own (the hall offers the merged one)",
      "steps": [
        {
          "do": "enter",
          "coc": "0EEJSSE001HouseBasement"
        },
        {
          "do": "reset"
        },
        {
          "check": "notify",
          "contains": "reset"
        },
        {
          "check": "layoutFile",
          "exists": false
        },
        {
          "check": "home",
          "layout": false
        },
        {
          "check": "bestTemplate",
          "source": null,
          "why": "the cellar has no template of its own: the merged Tundra Homestead template lists it, and only its main cell offers it"
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.9-tundra-g",
      "title": "A cell with a setup of its own is left out of the home",
      "manual": "needs the cellar with its own layout file while the hall's layout lists it (the panel note: 'has a setup of its own')"
    }
  ]
}