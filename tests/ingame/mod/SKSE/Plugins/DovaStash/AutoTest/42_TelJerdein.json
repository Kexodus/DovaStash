    {
      "id": "3.9e-TelJerdein",
      "title": "A cell not in the template: added from the Bedroom's door, saved, re-applied, removed",
      "steps": [
        {
          "do": "exitDoor",
          "ref": "rmp_telvannihearthfires.esp|0x00014D77"
        },
        {
          "check": "home",
          "is": false
        },
        {
          "do": "addArea",
          "label": "Outside"
        },
        {
          "check": "home",
          "is": true,
          "name": "Tel Jerdein - Bedroom",
          "layout": true
        },
        {
          "check": "log",
          "since": "action",
          "regex": "Add area: .* named \"Outside\""
        },
        {
          "do": "export",
          "name": "AutoTest TelJerdein"
        },
        {
          "check": "templateFile",
          "name": "AutoTest TelJerdein.json",
          "pointer": "/cells",
          "contains": {
            "cell": "Skyrim.esm|0x0000973D",
            "label": "Outside"
          }
        },
        {
          "check": "templateFile",
          "name": "AutoTest TelJerdein.json",
          "pointer": "/cells",
          "contains": {
            "cell": "rmp_telvannihearthfires.esp|0x0000AABB",
            "label": "Tel Jerdein - Foyer"
          }
        },
        {
          "do": "useTemplate",
          "source": "Templates/Mods/TelJerdein.json"
        },
        {
          "check": "layout",
          "pointer": "/cells",
          "contains": {
            "cell": "Skyrim.esm|0x0000973D"
          },
          "within": 5
        },
        {
          "do": "removeArea"
        },
        {
          "check": "notify",
          "since": "action",
          "regex": "is no longer part of"
        },
        {
          "check": "layout",
          "pointer": "/cells",
          "lacks": {
            "cell": "Skyrim.esm|0x0000973D"
          },
          "within": 5
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {"id": "3.7-TelJerdein", "title": "Displays in the Foyer (18 racks, mannequins and jars) are not filled from the Bedroom: a Deposit in the Bedroom puts nothing up in Tel Jerdein - Foyer (display fills are logged with their cell)",
      "steps": [
        {"do": "enter"},
        {"do": "additem", "item": "Skyrim.esm|0x00012EB7", "count": 1},
        {"do": "additem", "item": "Skyrim.esm|0x00013911", "count": 1},
        {"do": "additem", "item": "Skyrim.esm|0x000F456D", "count": 1},
        {"do": "snapshot", "name": "displays"},
        {"do": "op", "op": "Deposit"},
        {"do": "waitIdle"},
        {"check": "log", "regex": "Displays in .*: "},
        {"check": "log", "regex": "Display: .* on .*\\) in Tel Jerdein - Foyer$", "absent": true},
        {"check": "conserved", "snapshot": "displays"},
        {"check": "noErrors"}
      ]
    },
    {
      "id": "3.5-TelJerdein",
      "title": "Reset removes the setup: the Foyer is its own home again",
      "steps": [
        {
          "do": "enter",
          "cell": "rmp_telvannihearthfires.esp|0x00014D76"
        },
        {
          "do": "reset"
        },
        {
          "check": "notify",
          "regex": "Dova Stash: .* reset \\(setup backed up\\)",
          "within": 5
        },
        {
          "check": "layoutFile",
          "exists": false
        },
        {
          "check": "files",
          "dir": "Layouts",
          "regex": "rmp_telvannihearthfires\\.esp_00014D76\\.json\\.\\d{8}-\\d{6}(-\\d+)?\\.bak",
          "ge": 1
        },
        {
          "do": "enter",
          "cell": "rmp_telvannihearthfires.esp|0x0000AABB"
        },
        {
          "check": "home",
          "is": true,
          "name": "Tel Jerdein - Foyer",
          "layout": false
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.9f-TelJerdein",
      "title": "Deposit reaches persistent containers of another cell",
      "manual": "the template has no persistent container outside the Bedroom (Foyer and Root Cellar containers are not persistent): nothing to spread to; the non-persistent case is covered by 2.3"
    }
  ]
