{
  "$schema": "dovastash-autotest-1",
  "name": "Tel Jerdein (Telvanni Sorcerer Tower, three cells)",
  "home": "rmp_telvannihearthfires.esp|0x00014D76",
  "coc": "00RMP00TelvanniHearthfiresINT01",
  "tests": [
    {
      "id": "1.1",
      "title": "Template offered on the first visit",
      "steps": [
        {
          "do": "enter"
        },
        {
          "check": "home",
          "is": true,
          "name": "Tel Jerdein - Bedroom",
          "layout": false
        },
        {
          "check": "log",
          "since": "plan",
          "contains": "template available"
        },
        {
          "check": "notify",
          "since": "plan",
          "regex": "setup available \\(press K\\)"
        },
        {
          "check": "bestTemplate",
          "source": "Templates/Mods/TelJerdein.json"
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "1.2",
      "title": "No second notification in the same session",
      "steps": [
        {
          "do": "enter",
          "coc": "WhiterunBanneredMare"
        },
        {
          "do": "enter"
        },
        {
          "check": "notify",
          "since": "plan",
          "contains": "setup available",
          "count": 1,
          "within": 0
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.6",
      "title": "Use template: the shipped template is the one applied",
      "steps": [
        {
          "check": "bestTemplate",
          "source": "Templates/Mods/TelJerdein.json"
        },
        {
          "do": "useTemplate"
        },
        {
          "check": "layout",
          "pointer": "/basedOn",
          "contains": "Templates/Mods/TelJerdein.json@",
          "within": 5
        },
        {
          "check": "layout",
          "pointer": "/master",
          "eq": "rmp_telvannihearthfires.esp|0x00084894",
          "within": 5
        },
        {
          "check": "layout",
          "pointer": "/cells",
          "contains": {
            "cell": "rmp_telvannihearthfires.esp|0x0000AABB"
          },
          "within": 5
        },
        {
          "check": "layout",
          "pointer": "/cells",
          "contains": {
            "cell": "rmp_telvannihearthfires.esp|0x0008EADA"
          },
          "within": 5
        },
        {
          "check": "notify",
          "regex": "setup enabled",
          "since": "action",
          "within": 5
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "1.4-TelJerdein",
      "title": "A respawning container in the Foyer: accepted, the cell never resets",
      "steps": [
        {
          "do": "enter",
          "cell": "rmp_telvannihearthfires.esp|0x0000AABB"
        },
        {
          "do": "bind",
          "ref": "rmp_telvannihearthfires.esp|0x0011CDE9",
          "category": "misc.clutter"
        },
        {
          "check": "log",
          "since": "action",
          "contains": "has the respawn flag; accepted because the cell never resets"
        },
        {
          "check": "layout",
          "pointer": "/containers",
          "contains": {
            "ref": "rmp_telvannihearthfires.esp|0x0011CDE9",
            "categories": [
              "misc.clutter"
            ]
          },
          "within": 5
        },
        {
          "do": "unbind",
          "ref": "rmp_telvannihearthfires.esp|0x0011CDE9",
          "category": "misc.clutter"
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "2.2-TelJerdein",
      "title": "Inventory: items with no container in the Bedroom",
      "steps": [
        {
          "do": "enter"
        },
        {
          "do": "clearInventory"
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x0005ACE4",
          "count": 4
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x000800E4",
          "count": 4
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x00064B41",
          "count": 1
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x0003EADD",
          "count": 2
        },
        {
          "do": "snapshot",
          "name": "inventory"
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "2.3-TelJerdein",
      "title": "Deposit in the Bedroom: nothing lost (the apron goes to a mannequin, which takes it out of its dresser)",
      "steps": [
        {
          "do": "op",
          "op": "Deposit"
        },
        {
          "do": "waitIdle"
        },
        {
          "check": "notify",
          "regex": "Dova Stash: deposited \\d+ items?"
        },
        {
          "check": "conserved",
          "snapshot": "inventory",
          "ignore": [
            "Skyrim.esm|0x0005B69F",
            "Skyrim.esm|0x0005B6A1",
            "Skyrim.esm|0x00080697"
          ]
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.9-TelJerdein",
      "title": "Foyer (another cell): home with the Bedroom's name, Deposit and Retrieve from there",
      "steps": [
        {
          "do": "enter",
          "cell": "rmp_telvannihearthfires.esp|0x0000AABB"
        },
        {
          "check": "home",
          "is": true,
          "name": "Tel Jerdein - Bedroom",
          "layout": true
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x0003EADD",
          "count": 2
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x00064B41",
          "count": 1
        },
        {
          "do": "snapshot",
          "name": "foyer"
        },
        {
          "do": "op",
          "op": "Deposit"
        },
        {
          "do": "waitIdle"
        },
        {
          "check": "count",
          "in": "rmp_telvannihearthfires.esp|0x000AD226",
          "item": "Skyrim.esm|0x0003EADD",
          "from": "foyer",
          "ge": 2
        },
        {
          "check": "count",
          "in": "rmp_telvannihearthfires.esp|0x001781D7",
          "item": "Skyrim.esm|0x00064B41",
          "from": "foyer",
          "ge": 1
        },
        {
          "check": "conserved",
          "snapshot": "foyer",
          "ignore": [
            "Skyrim.esm|0x000209A6",
            "Skyrim.esm|0x00080697"
          ]
        },
        {
          "check": "noErrors"
        },
        {
          "do": "snapshot",
          "name": "back"
        },
        {
          "do": "op",
          "op": "Retrieve",
          "pattern": "alchemy.potions"
        },
        {
          "do": "waitIdle"
        },
        {
          "check": "count",
          "item": "Skyrim.esm|0x0003EADD",
          "from": "back",
          "ge": 1
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.3-TelJerdein",
      "title": "Learn by hand in the Foyer: a dagger put into the Potions container",
      "steps": [
        {
          "do": "enter",
          "cell": "rmp_telvannihearthfires.esp|0x0000AABB"
        },
        {
          "do": "additem",
          "item": "Skyrim.esm|0x0001397E",
          "count": 1
        },
        {
          "do": "openContainer",
          "ref": "rmp_telvannihearthfires.esp|0x000AD226"
        },
        {
          "do": "store",
          "to": "rmp_telvannihearthfires.esp|0x000AD226",
          "item": "Skyrim.esm|0x0001397E",
          "count": 1
        },
        {
          "do": "wait",
          "seconds": 1
        },
        {
          "do": "closeMenu"
        },
        {
          "check": "notify",
          "since": "plan",
          "regex": "now goes to",
          "within": 5
        },
        {
          "check": "layout",
          "pointer": "/learned/Skyrim.esm|0x0001397E",
          "eq": "rmp_telvannihearthfires.esp|0x000AD226",
          "within": 5
        },
        {
          "check": "noErrors"
        }
      ]
    },
    {
      "id": "3.4-TelJerdein",
      "title": "Sort all from the Foyer",
      "steps": [
        {
          "do": "enter",
          "cell": "rmp_telvannihearthfires.esp|0x0000AABB"
        },
        {
          "do": "snapshot",
          "name": "sortall"
        },
        {
          "do": "op",
          "op": "SortAll"
        },
        {
          "do": "waitIdle"
        },
        {
          "check": "notify",
          "since": "plan",
          "regex": "re-sorted \\d+ items?|everything is already in place"
        },
        {
          "check": "conserved",
          "snapshot": "sortall",
          "ignore": [
            "Skyrim.esm|0x0001397E"
          ]
        },
        {
          "check": "noErrors"
        }
      ]
    },
