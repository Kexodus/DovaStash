        {"check": "layout", "pointer": "/master", "eq": "HearthFires.esm|0x0000309E", "within": 5},
        {"check": "layout", "pointer": "/cells", "contains": {"cell": "HearthFires.esm|0x00004849", "label": "Cellar"}},
        {"do": "enter", "coc": "BYOHHouse1Exterior"},
        {"do": "buyHome"},
        {"do": "enter", "coc": "BYOHHouse1FalkreathBasement"},
        {"do": "buyHome"},
        {"do": "enter"},
        {"check": "noErrors"}
      ]
    },
