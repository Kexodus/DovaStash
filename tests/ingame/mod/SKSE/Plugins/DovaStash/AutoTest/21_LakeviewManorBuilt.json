    {
      "id": "6.2.5-lakeview-browse",
      "title": "Message boxes, Browse containers... in a big home (more than 3 pages): one line per area (\"<area> (N)...\"), the masters first; Cancel changes nothing",
      "steps": [
        {
          "do": "enter"
        },
        {
          "do": "settings",
          "set": {
            "iMode": 1
          }
        },
        {
          "do": "aim",
          "ref": null
        },
        {
          "do": "hotkey"
        },
        {
          "check": "menuEntries",
          "contains": [
            "Advanced..."
          ],
          "within": 5
        },
        {
          "do": "choose",
          "entry": "Advanced..."
        },
        {
          "check": "menuEntries",
          "contains": [
            "Browse containers..."
          ],
          "within": 5
        },
        {
          "do": "choose",
          "entry": "Browse containers..."
        },
        {
          "check": "menuEntries",
          "includes": [
            " - master (",
            ")..."
          ],
          "body": "Browse containers",
          "within": 5
        },
        {
          "do": "choose",
          "entry": "Cancel"
        },
        {
          "do": "aim",
          "clear": true
        },
        {
          "check": "noErrors"
        }
      ]
    },
