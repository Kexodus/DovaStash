; Dova Stash settings.
; Location: Data/SKSE/Plugins/DovaStash.ini. Missing keys fall back to the defaults shown here.

[General]
; Log verbosity for My Games/Skyrim Special Edition/SKSE/DovaStash.log
; 0 = trace, 1 = debug, 2 = info, 3 = warn, 4 = error, 5 = critical, 6 = off
; Set 0 when you report a problem: it logs everything.
iLogLevel = 2

; true = when you enter a home that has a template, enable it automatically (not while a saved setup
; of your own can be restored there: Dova Stash keeps a copy of every setup in
; Documents/My Games/Skyrim Special Edition/SKSE/DovaStash/Backups).
; false = show a one-time notification and wait for you to press the hotkey.
bAutoEnableTemplates = true

[Input]
; Keyboard hotkey as a DirectInput scan code (decimal). 37 = K.
; K is not bound by vanilla Skyrim's PC control map. Full list of codes:
; https://ck.uesp.net/wiki/Input_Script#DXScanCodes
iHotkey = 37

; Gamepad hotkey as an SKSE gamepad key code (decimal), -1 = disabled.
; Every gamepad button already has a vanilla function, so this is off by default.
; 266 DPad Up, 267 DPad Down, 268 DPad Left, 269 DPad Right, 270 Start, 271 Back,
; 272 Left Thumb, 273 Right Thumb, 274 LB, 275 RB, 276 A, 277 B, 278 X, 279 Y, 280 LT, 281 RT
iGamepadHotkey = -1

[Sorting]
; true = closing the master container sorts its contents into the other containers.
bDistributeOnMasterClose = true

; true = anything you put into the master container is sorted out of it right away, while its menu
; is still open (handy with Skyrim Souls).
bSortOnArrival = true

; true = putting an item into a managed container by hand (container menu open) remembers that
; container as the item's destination ("learned destinations"). Enchanted or otherwise variant items
; count as the item they are made from: an "Iron Sword of Burning" teaches where iron swords go.
bLearn = true

; After this many learned items of one category point at the same container, Dova Stash asks once
; when you close it: "Send all Books to End Table?". Yes binds the category to the container (the
; learned items it now covers are dropped); No is remembered for that container and category.
; 0 = never ask.
iSuggestCategoryAfter = 3

; For this many seconds after something was learned, the hotkey takes it back ("... now goes to
; End Table (K: undo)"). 0 = no undo.
iLearnUndoSeconds = 5

; true = Deposit and Sort all put your gear on the displays you use, as if you had placed it by hand.
; Turn a display on with the hotkey (look at a weapon rack, mannequin or plaque and choose "Use this
; rack"), and pick what it takes under "Categories...", like a container; templates can turn some on
; too. Racks get your best weapons and shields (one of each), mannequins a matching armor set (or the
; one you pick under "Armor set..."), and
; plaques made for one item (dragon priest masks, claws, Elder Scrolls...) that item. Nothing is ever taken off a display; take things down by hand as usual.
bFillDisplays = true

; true = sit down at a crafting station in a home you set up (forge, smelter, tanning rack, sharpening
; wheel, armor table, cooking pot, alchemy lab, enchanter, and modded stations) and the materials its
; recipes use come out of your containers into your inventory. When you get up, what you didn't use goes
; back where it came from. What you just made stays with you, and so do the copies you carried before.
; The recipes are read from your load order, so modded materials and recipes work without a patch.
; Alchemy labs bring your ingredients, enchanters your filled soul gems.
bCraftingSupply = true

; true = also bring weapons, armor and ammo that recipes use as materials (breakdown recipes at the
; smelter, upgrade recipes like the Enhanced Crossbow). Off by default: with a breakdown mod, the
; smelter would otherwise bring out every piece of gear you store. Tempered or enchanted copies never come.
bCraftingSupplyGear = false

[UI]
; What the hotkey opens in the world. Dova Stash draws no menus of its own art: every option below
; uses a menu you already have, so whatever UI skin you use applies (any UIExtensions skin, or none).
; 0 = auto: UIExtensions list menus when UIExtensions is installed (not on VR), else native
;     message boxes. The SKSE Menu Framework panel stays available from that framework's menu as the editor.
; 1 = always native message boxes
; 2 = the SKSE Menu Framework panel (falls back to message boxes if the framework is not loaded)
; 3 = always UIExtensions (falls back to message boxes if it is not installed)
iMode = 0

; true = UIExtensions lists and the rename box open in the middle of the screen, whatever position
; your UIExtensions skin gives them.
bCenterMenus = true

[Integrations]
; QuickLoot IE: show what a container holds and where the selected item would go in QuickLoot's
; info bar, plus a "Dova Stash" hotkey button in its button bar.
bQuickLoot = true

; QuickLoot IE: show where each item would be sorted to, right in QuickLoot's item list
; ("Iron Sword  >  Weapon Rack"). Only in your homes, only for items that belong somewhere else.
bQuickLootItemTags = true

; QuickLoot IE: show a container's categories as icons (your SkyUI/I4 icons, one per category) in the
; bottom-right corner of QuickLoot, instead of their names. The master still says "Master".
bQuickLootIcons = true

; Add a container's role to the activate prompt, e.g. "Chest (Weapons, Armor)". Works on VR too.
; Nothing is written to your save.
bActivatePrompt = true

[Overlay]
; Floating icons above managed containers while you are in an enabled home. The icons are your own:
; the same icon your inventory shows (SkyUI, plus I4 rules and icon packs when installed).
; Not available on VR. Off by default.
bEnabled = false

; How far away icons are shown, in game units (about 70 units per metre).
fRadius = 1200

; At most this many icons at once (the nearest ones).
iMaxIcons = 12

; Icon size on the HUD when you stand close (it shrinks with distance).
fIconSize = 40

; true = only show icons for containers you can see (not through walls).
bRequireLineOfSight = true
